{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "nodenext",
    "moduleDetection": "force",
    "jsx": "preserve",
    "allowJs": true,
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    // Node runs these sources by stripping types. Anything non-erasable
    // (enums, namespaces, constructor parameter properties) parses fine under
    // vitest's esbuild but crashes the real server at startup, so fail here.
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "types": ["node"]
  },
  "include": ["src/**/*", "tests/**/*", "examples/**/*"]
}
