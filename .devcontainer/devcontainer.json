{
  "name": "Iriguchi",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:26",
  "remoteUser": "node",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "workspaceFolder": "/workspaces/iriguchi",
  "forwardPorts": [4000, 4001],
  "portsAttributes": {
    "4000": { "label": "iriguchi gateway", "onAutoForward": "notify" },
    "4001": { "label": "weather-app demo", "onAutoForward": "silent" }
  },
  "postCreateCommand": "npm install && cd examples/weather-app && npm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  }
}
