# Required
IRI_API_KEY=
IRI_REGISTRATION_SECRET=

# Providers — configure one or more. Name is arbitrary uppercase alphanumeric.
# Each provider requires all three vars: API_KEY, BASE_URL, DEFAULT_MODEL.
# Optional fourth: AUTH_STYLE=api_key (default) | auth_token — see OpenRouter below.
IRI_PROVIDER_ANTHROPIC_API_KEY=
IRI_PROVIDER_ANTHROPIC_BASE_URL=https://api.anthropic.com
IRI_PROVIDER_ANTHROPIC_DEFAULT_MODEL=claude-opus-5

# Example: OpenRouter via its Anthropic-compatible surface ("Anthropic Skin").
# Note the base URL is the bare /api root — the client appends /v1/messages.
# AUTH_STYLE=auth_token is REQUIRED here: OpenRouter reads the key from
# ANTHROPIC_AUTH_TOKEN, and the gateway must also send an empty
# ANTHROPIC_API_KEY. Without it the runtime silently authenticates against
# Anthropic directly instead of OpenRouter.
# Model names are OpenRouter slugs — "moonshotai/", not "moonshot/".
# Billed per token, unlike a local provider.
# IRI_PROVIDER_OPENROUTER_API_KEY=sk-or-...
# IRI_PROVIDER_OPENROUTER_BASE_URL=https://openrouter.ai/api
# IRI_PROVIDER_OPENROUTER_DEFAULT_MODEL=moonshotai/kimi-k3
# IRI_PROVIDER_OPENROUTER_AUTH_STYLE=auth_token

# Example: local LM Studio (API key required non-empty but unused).
# IRI_PROVIDER_LMSTUDIO_API_KEY=lm-studio
# IRI_PROVIDER_LMSTUDIO_BASE_URL=http://localhost:1234
# IRI_PROVIDER_LMSTUDIO_DEFAULT_MODEL=ornith-1.0-35b

# Which provider handles vanilla requests (no iri_agent) and agents that omit `provider`.
# Optional if exactly one provider is configured; required otherwise.
IRI_DEFAULT_PROVIDER=anthropic

# Optional with defaults
IRI_PORT=4000
IRI_MAX_AGENT_TURNS=20
IRI_TOOL_CALL_TIMEOUT_MS=30000
IRI_MANIFEST_CACHE_TTL_MS=300000
IRI_MCP_CACHE_TTL_MS=300000
# Comma-separated origin allowlist for MCP servers named in app manifests.
# Unset means unrestricted. Enforced at registration and again at connect time.
# IRI_MCP_ALLOWED_ORIGINS=http://finance-mcp.finance-app.svc.cluster.local:8080
IRI_REQUEST_TIMEOUT_MS=300000
IRI_DB_PATH=./iriguchi.db
IRI_TMP_DIR=./.iri-tmp
